{
  "uid": "parcial-logs",
  "title": "Logs de parcial-jjlr",
  "tags": ["loki"],
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Líneas de log por aplicación",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (count_over_time({namespace=\"parcial-jjlr\"}[5m]))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "nginx",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [{ "refId": "A", "expr": "{namespace=\"parcial-jjlr\", app=\"nginx\"}" }]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "apache",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [{ "refId": "A", "expr": "{namespace=\"parcial-jjlr\", app=\"apache\"}" }]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "whoami",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [{ "refId": "A", "expr": "{namespace=\"parcial-jjlr\", app=\"whoami\"}" }]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "grafana",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [{ "refId": "A", "expr": "{namespace=\"parcial-jjlr\", app=\"grafana\"}" }]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Traefik (access logs)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [{ "refId": "A", "expr": "{namespace=\"traefik\"}" }]
    }
  ]
}
