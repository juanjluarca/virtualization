{
  "uid": "cluster-metrics",
  "title": "Métricas del clúster",
  "tags": ["kubernetes"],
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CPU usada (núcleos)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 2 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[5m]))" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Memoria usada",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(container_memory_working_set_bytes{container!=\"\"})" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pods en Running",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(kube_pod_status_phase{phase=\"Running\"})" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pods fuera de Running",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(kube_pod_status_phase{phase!=\"Running\"})" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU por namespace (núcleos)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (rate(container_cpu_usage_seconds_total{container!=\"\"}[5m]))",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memoria por namespace",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (container_memory_working_set_bytes{container!=\"\"})",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Estado de los pods",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_status_phase == 1",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["namespace", "pod", "phase"] } } },
        { "id": "sortBy", "options": { "sort": [{ "field": "namespace" }] } }
      ]
    }
  ]
}
